# Formspree form endpoint (free tier).
#
# Create a form at https://formspree.io with your account's inbox set to
# support@vidyainfotechindia.com, then copy the form ID shown on the
# form's integration page (the 8-char ID after /f/) into your local
# `.env.local` file, e.g.:
#
#   NEXT_PUBLIC_FORMSPREE_FORM_ID=yourformid
#
# The contact form stays inert (Call/WhatsApp fallback) until this is set.
NEXT_PUBLIC_FORMSPREE_FORM_ID=
