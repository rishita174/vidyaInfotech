# Enquiry architecture (Neon Postgres + Resend email).
#
# Copy this file to `.env` locally or set the variables in your hosting
# provider (Vercel) settings. Server-side only — never NEXT_PUBLIC_.

# Neon Postgres connection string (serverless HTTP endpoint).
# Create a free project at https://neon.tech, copy the pooled connection string.
DATABASE_URL=

# Resend API key (https://resend.com/api-keys).
RESEND_API_KEY=

# Sender address for transactional email. Must be a verified domain/sender in
# Resend (e.g. enquiries@vidyainfotech.in). Defaults to the site email.
RESEND_FROM_EMAIL=
